# Public assets: keep only images actually used
# Allow tracked folder for used images
!public/images-used/
!public/images-used/**

# Ignore all other images under public/images
public/images/**

# Ignore other optimized outputs if any
public/optimized/**

# Videos: ignore all except the current hero video
public/**/*.mp4
public/**/*.mov
!public/video-output-02B0EFCF-7710-41BF-B442-B39610C77A3F-2.mov

